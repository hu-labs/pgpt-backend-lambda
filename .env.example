# Copy to .env.preview.local or .env.production.local. Values are dotenv data,
# not shell commands. Quote passwords, especially when they contain # or spaces.
AWS_REGION=eu-west-2
# Keep the /chat suffix; direct API Gateway URLs include the /test stage.
TEST_API_URL=https://<api-id>.execute-api.eu-west-2.amazonaws.com/test/chat
PUBLIC_API_URL=https://<domain>/api/v1/chat
TEST_API_KEY=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_USERNAME=
COGNITO_PASSWORD=
# Optional second account in the same user pool, for cross-user isolation checks.
COGNITO_SECOND_USERNAME=
COGNITO_SECOND_PASSWORD=
